<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема приложения: темный глубокий фон, устраняющий белый флэш при старте -->
    <style name="Theme.SplateClient" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0F19</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Тема для Splash Screen (Android 12+ и обратная совместимость androidx.core:core-splashscreen) -->
    <style name="Theme.SplateClient.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0F19</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.SplateClient</item>
    </style>
</resources>
